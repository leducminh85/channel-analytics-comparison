generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GroupShareRole {
  VIEWER
  EDITOR
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String         @default("USER")
  monthlyComparisonSettings Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  accounts      Account[]
  compareGroups CompareGroup[]
  groupShares   CompareGroupShare[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CompareGroup {
  id        String         @id @default(cuid())
  name      String
  icon      String?  // To store the chosen logo/icon identifier
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels  GroupChannel[]
  shares    CompareGroupShare[]

  @@map("compare_groups")
}

model CompareGroupShare {
  id        String         @id @default(cuid())
  groupId   String
  userId    String
  role      GroupShareRole @default(VIEWER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  group     CompareGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("compare_group_shares")
}

model Channel {
  id              String         @id @default(cuid())
  channel_id      String         @unique
  channel_url     String
  title           String
  logo_url        String?
  subscriberCount Int            @default(0)
  videoCount      Int            @default(0)
  viewCount       BigInt         @default(0)
  uploadFrequency String?
  views30Days     BigInt         @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  dailyStats      DailyStat[]
  monthlyStats    MonthlyStat[]
  groups          GroupChannel[]

  @@map("channels")
}

model GroupChannel {
  groupId    String
  channelId  String
  assignedAt DateTime     @default(now())
  channel    Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  group      CompareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, channelId])
  @@map("group_channels")
}

model DailyStat {
  id                 String   @id @default(cuid())
  channelId          String
  date_str           String
  views              BigInt   @default(0)
  views_change       BigInt   @default(0)
  subscribers        Int      @default(0)
  subscribers_change Int      @default(0)
  createdAt          DateTime @default(now())
  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date_str])
  @@map("daily_stats")
}

model MonthlyStat {
  id                 String   @id @default(cuid())
  channelId          String
  month              String   // Format: YYYY-MM
  views_gained       BigInt   @default(0)
  total_views        BigInt   @default(0)
  subscribers        Int      @default(0)
  subscribers_change Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, month])
  @@map("monthly_stats")
}
